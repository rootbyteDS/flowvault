# Wird von Docker Compose gelesen (docker-compose.yml bzw. Arcane).
# Beim Start über npm wird diese Datei nicht geladen – dort Variablen in der Shell setzen.

# Pflicht. Erzeugen mit: openssl rand -base64 32 – bei bestehender Installation nicht ändern.
APP_SECRET=

# Optional: feste Admin-Zugangsdaten statt Einrichtung im Browser.
# Werte mit $ in einfache Anführungszeichen setzen, z. B. ADMIN_PASSWORD='pa$$wort'.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Hinter einem Reverse Proxy mit HTTPS (Caddy, Traefik, nginx) unbedingt setzen,
# sonst trifft die Login-Sperre alle Nutzer gleichzeitig.
# TRUST_PROXY=1

# Sprache für Server-Logs und KI-Änderungstexte sowie Ausweichsprache der Oberfläche: de oder en (Standard: de).
# Die Oberfläche folgt sonst der Browsersprache und lässt sich im Browser umstellen.
# DEFAULT_LANGUAGE=de

# Optional: externer Deployment-Webhook für den UI-Update-Button (POST).
# UPDATE_WEBHOOK_URL=https://deployment.example.com/trigger
# UPDATE_WEBHOOK_TOKEN=
# UPDATE_MANAGEMENT_URL=https://deployment.example.com/projects/flowvault

# Optional beim Docker-Build: voller Git-Commit des gebauten Quellcodes.
# APP_REVISION=
