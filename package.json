{
  "name": "flowvault",
  "version": "0.3.7",
  "private": true,
  "license": "MIT",
  "description": "Versionierung & Backup für n8n-Workflows – wie GitHub, nur für n8n.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.ts",
    "version:bump": "node scripts/version.ts bump",
    "version:check": "node scripts/version.ts check",
    "changelog:check": "node scripts/changelog.ts check",
    "dev": "concurrently -n api,web -c magenta,cyan \"node --watch-path=server --watch-path=services --watch-path=shared server/index.ts\" \"vite\"",
    "build": "vite build && node scripts/build-info.ts",
    "start": "NODE_ENV=production node server/index.ts",
    "test": "node --test scripts/version.test.ts scripts/changelog.test.ts shared/i18n/i18n.test.ts shared/dashboard.test.ts shared/redact.test.ts server/auth.test.ts server/ai.test.ts server/updates.test.ts server/snapshots.test.ts server/internal.test.ts server/promote/transform.test.ts server/promote/promote.test.ts services/health/analysis.test.ts services/health/history.test.ts services/health/failures.test.ts services/mcp/verdict.test.ts services/mcp/mcp.test.ts web/src/heatmap.test.ts web/src/execution-history.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock-n8n": "node scripts/mock-n8n.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "diff": "^8.0.4",
    "express": "^5.3.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
